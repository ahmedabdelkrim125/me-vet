+          style: AppTextStyles.cairoBold18
+              .copyWith(color: Colors.white, fontSize: 15.sp),
+        ),
+      ),
+      body: _loadingCatalog
+          ? const Center(child: CircularProgressIndicator())
+          : ListView(
+              padding: EdgeInsets.fromLTRB(16.w, 14.h, 16.w, 100.h),
