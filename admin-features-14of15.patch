+                      '${_invoiceDate.year}/${_invoiceDate.month.toString().padLeft(2, '0')}/${_invoiceDate.day.toString().padLeft(2, '0')}',
+                    ),
+                  ),
+                ),
+                SizedBox(height: 14.h),
+                Row(
