 class VehicleStockReportBuilder {
   VehicleStockReportBuilder._();
 
+  /// Some product/category names picked up invisible Unicode characters
+  /// (zero-width joiners/spaces, BOM, bidi override marks) — almost always
+  /// from pasting text in from WhatsApp or another app. The PDF font has no
+  /// glyph for them, and it turns out that is enough to make the pdf
+  /// package's page-splitting logic loop forever instead of laying the text
+  /// out — `TooManyPagesException`, with no useful stack trace. Stripping
+  /// these before they ever reach `pw.Text` makes that failure impossible,
+  /// regardless of what ends up in a product name in the future.
+  static String _sanitize(String text) =>
+      text.replaceAll(RegExp(r'[\u200B-\u200F\u202A-\u202E\uFEFF]'), '');
+
   static final _navy = PdfColor.fromInt(AppColors.primary.value);
