-String _normalizeArabic(String input) {
-  return input
-      .toLowerCase()
-      .replaceAll(RegExp(r'[\u064B-\u065F\u0670\u0640]'), '')
-      .replaceAll(RegExp('[أإآ]'), 'ا')
-      .replaceAll('ى', 'ي')
-      .replaceAll('ة', 'ه')
-      .trim();
-}
